{
  "schema_version": 1,
  "operation": "denoise",
  "media": "video",
  "content": "photo",
  "input": "source.mkv",
  "output": "output.mkv",
  "backend": "auto",
  "colorspace": "srgb",
  "alpha": "opaque",
  "limits": {
    "threads": 1,
    "memory_mb": 256,
    "timeout_secs": 60,
    "max_pixels": 1048576,
    "max_input_mb": 64,
    "max_output_mb": 64,
    "min_free_disk_mb": 700
  }
}
