{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DCC Media Enhance batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "jobs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "job.schema.json"
      }
    }
  }
}
