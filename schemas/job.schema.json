{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DCC Media Enhance job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "media",
    "content",
    "input",
    "output",
    "backend",
    "colorspace",
    "alpha",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "denoise",
        "upscale",
        "resize"
      ]
    },
    "media": {
      "enum": [
        "image",
        "video"
      ]
    },
    "content": {
      "enum": [
        "render",
        "photo",
        "illustration"
      ]
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "enum": [
        "auto",
        "blender-oidn",
        "ffmpeg-nlmeans",
        "ffmpeg-atadenoise",
        "ffmpeg-lanczos",
        "waifu2x-cpu"
      ]
    },
    "colorspace": {
      "enum": [
        "scene-linear",
        "srgb"
      ]
    },
    "alpha": {
      "const": "opaque"
    },
    "scale": {
      "const": 2
    },
    "model_dir": {
      "type": "string"
    },
    "passes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beauty",
        "normal",
        "albedo",
        "layer"
      ],
      "properties": {
        "beauty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "normal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "albedo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "layer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threads",
        "memory_mb",
        "timeout_secs",
        "max_pixels",
        "max_input_mb",
        "max_output_mb",
        "min_free_disk_mb"
      ],
      "properties": {
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 65536
        },
        "timeout_secs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "max_input_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_output_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "min_free_disk_mb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    }
  }
}
